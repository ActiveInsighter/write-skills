{
  "name": "write-skills",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run lint && npm run types:check && npm run typecheck && npm run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:ui && npm run test:worker",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc -b --pretty false",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "preview": "vite preview",
    "deploy": "npm run check && npm run build && wrangler deploy --dry-run && npm run d1:migrate:remote && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:prepare": "node scripts/prepare-cloudflare.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-character-count": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-subscript": "3.29.2",
    "@tiptap/extension-superscript": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-typography": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
