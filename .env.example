# Copy this file to .dev.vars for local Worker development.
# Never put CLOUDFLARE_API_TOKEN or other deployment credentials here.

# Optional shared access password. Leave blank to disable the login gate.
APP_PASSWORD=

# Recommended whenever APP_PASSWORD is set.
# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# GitHub Actions uses an Environment secret named ACCESS_PASSWORD and maps it
# to the Worker secret APP_PASSWORD. ACCESS_PASSWORD is not read by local code.
